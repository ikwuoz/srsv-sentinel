# Copy to .env and fill in. All values optional unless noted.
# Sentinel core
SOURCE=mock            # mock | live
PORT=8787              # HTTP API port (serve)
POLL_MS=30000          # watch-loop interval
EPOCH_LEN_SEC=86400    # epoch length (whitepaper redacts; override at launch)
DATA_DIR=              # default: ./data
# Live v4 source (required when SOURCE=live)
RPC_URL=               # https/wss endpoint (may embed provider API key)
POOL=                  # v4 PoolId, bytes32 hex
POOL_MANAGER=          # override for non-mainnet Uniswap v4 singleton
CONFIRMATIONS=5        # epochs finalize this many blocks behind tip (reorg safety)
# Telegram alerts (transitions-only; both required to enable)
TELEGRAM_BOT_TOKEN=    # from @BotFather
TELEGRAM_CHAT_ID=      # channel/chat id the bot posts to
